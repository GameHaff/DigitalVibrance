<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DigitalVibrance</AssemblyName>
    <RootNamespace>DigitalVibrance</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <Title>Digital Vibrance</Title>
    <AssemblyTitle>Digital Vibrance</AssemblyTitle>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <InformationalVersion>3</InformationalVersion>
    <Product>Digital Vibrance</Product>
    <Company>SYTStudio</Company>
    <Description>Digital Vibrance</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinForms is only referenced for the tray icon; DPI is owned by the WPF manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Embedded so a built-in language can never go missing at runtime. Extra or corrected
         packs can still be dropped into %AppData%\DigitalVibrance\Languages. -->
    <EmbeddedResource Include="Localization\Languages\*.json" />
  </ItemGroup>

</Project>
