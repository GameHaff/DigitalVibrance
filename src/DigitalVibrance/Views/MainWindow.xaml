    <Window x:Class="DigitalVibrance.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DigitalVibrance.Views"
        xmlns:loc="clr-namespace:DigitalVibrance.Localization"
        xmlns:vm="clr-namespace:DigitalVibrance.ViewModels"
        Icon="pack://application:,,,/DigitalVibrance;component/Assets/app.ico"
        Title="Digital Vibrance"
        Width="1120" Height="720" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource Border}"
        AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop"
        FlowDirection="{Binding FlowDirection}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

        <Border x:Name="ShellShell" Margin="0" Padding="0" Background="{DynamicResource Border}" CornerRadius="16"
                BorderBrush="{DynamicResource Border}" BorderThickness="0.5"
                SnapsToDevicePixels="True" ClipToBounds="True">
        <Border x:Name="InnerShell" Margin="1" CornerRadius="13" Background="{DynamicResource Bg}"
                SnapsToDevicePixels="True" ClipToBounds="True">
        <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ==================== title bar ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="13,13,0,0" ClipToBounds="True"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
            <Border VerticalAlignment="Bottom" Height="0.6" Background="{DynamicResource Border}" Opacity="0.85"/>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="30" Height="30" Background="{DynamicResource Surface}" CornerRadius="12" Padding="5"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.12"/>
                    </Border.Effect>
                    <Grid>
                        <Ellipse Fill="{DynamicResource AccentGrad}" Opacity="0.16"/>
                        <Image x:Name="BrandIcon" Width="20" Height="20" Stretch="Uniform"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               ImageFailed="OnBrandIconFailed"/>
                        <TextBlock x:Name="BrandGlyphFallback" Text="DV" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDim}"
                                   FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <TextBlock Text="Digital Vibrance" FontWeight="SemiBold" FontSize="12.5"
                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource Card}" CornerRadius="5" Padding="7,2"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Tagline}" FontSize="10"
                               Foreground="{DynamicResource TextFaint}"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Button Style="{StaticResource CaptionButton}" Command="{Binding ToggleThemeCommand}"
                        Content="{Binding ThemeGlyph}" FontSize="13" Width="38"
                        ToolTip="{loc:T ThemeTip}"/>

                <ToggleButton x:Name="LangButton" Style="{StaticResource LangToggle}"
                              IsChecked="{Binding IsLanguageMenuOpen, Mode=TwoWay}"
                              ToolTip="{loc:T LanguageTip}" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentLanguage.Name}" FontSize="12"
                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsLanguageMenuOpen, Mode=TwoWay}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=LangButton}" Placement="Bottom"
                       VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="6"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.16" Color="#000000"/>
                        </Border.Effect>
                        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Languages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LangItem}"
                                                Command="{Binding DataContext.SetLanguageCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid Width="196">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding EnglishName}"
                                                               Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource Accent2}"
                                                           Visibility="{Binding IsCurrent,
                                                                        Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <TextBlock Text="{loc:T Master}" FontSize="12" Foreground="{DynamicResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MasterEnabled}"
                              ToolTip="{loc:T MasterTip}" VerticalAlignment="Center"
                              Margin="0,0,14,0"/>
                <Button Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="OnClose" ToolTip="{loc:T WinClose}"/>
            </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== content ==================== -->
        <Border Grid.Row="1" Margin="14,14,14,10" CornerRadius="18" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#000000" Opacity="0.05"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="384"/>
                </Grid.ColumnDefinitions>

            <!-- ===== game library ===== -->
            <Grid Grid.Column="0" Margin="22,20,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,12,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T GamesTitle}" Style="{StaticResource H1}"/>
                        <Border Background="{DynamicResource Card}" CornerRadius="9" Padding="7,1"
                                Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Games.Count}" FontSize="11"
                                       Foreground="{DynamicResource TextDim}"/>
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            Command="{Binding AddGameCommand}" Content="{loc:T GamesAdd}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GameCard}"
                                            Command="{Binding DataContext.SelectGameCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding ExecutablePath}">
                                        <Grid Width="156" Height="150">
                                            <Grid Margin="14,14,14,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Border Width="46" Height="46" CornerRadius="10"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource AccentGrad}" Opacity="0.18"/>
                                                    <!-- icons must not mirror in right-to-left layouts -->
                                                    <Image Source="{Binding Icon}" Width="46" Height="46"
                                                           HorizontalAlignment="Left"
                                                           FlowDirection="LeftToRight"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Visibility="{Binding IsActive,
                                                                             Converter={StaticResource BoolToVis}}">
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{loc:T StatusActive}" FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Success}"
                                                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ExecutableName}"
                                                               Style="{StaticResource Caption}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                                    <Border Background="{DynamicResource Bg}" CornerRadius="5"
                                                            Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Accent2}">
                                                            <Run Text="{Binding Color.Vibrance, Mode=OneWay}"/><Run Text="%"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="{DynamicResource DangerFill}" CornerRadius="5" Padding="6,2"
                                                            HorizontalAlignment="Right"
                                                            Visibility="{Binding Color.OverrideEnabled,
                                                                         Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="OVR" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Danger}"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- empty state -->
                        <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="40,44"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                VerticalAlignment="Top" Margin="0,4,12,0"
                                Visibility="{Binding NoGames, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="16"
                                        Background="{DynamicResource AccentGrad}" Opacity="0.22"
                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Text="{loc:T EmptyHint}" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="{loc:T GamesAdd}"
                                        Command="{Binding AddGameCommand}" HorizontalAlignment="Center"
                                        Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ===== settings panel ===== -->
            <Border Grid.Column="1" Background="{DynamicResource Bg}" CornerRadius="0,18,18,0"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- panel header -->
                    <Border Grid.Row="0" Padding="20,18" BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <!-- game header -->
                            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding SelectedGame.Icon}"
                                       Width="38" Height="38" VerticalAlignment="Top"
                                       FlowDirection="LeftToRight"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                    <TextBox Style="{StaticResource DvTextBox}"
                                             Text="{Binding SelectedGame.Name, UpdateSourceTrigger=PropertyChanged}"
                                             FontWeight="SemiBold" Padding="8,5"/>
                                    <TextBlock Text="{Binding SelectedGame.ExecutableName}"
                                               Style="{StaticResource Caption}" Margin="2,5,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                              IsChecked="{Binding SelectedGame.Enabled}"
                                              VerticalAlignment="Top" Margin="0,7,0,0"
                                              ToolTip="{loc:T ProfileToggleTip}"/>
                            </Grid>

                            <!-- desktop header -->
                            <Grid Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T DesktopTitle}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:T DesktopSubtitle}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <ToggleButton Style="{StaticResource Switch}"
                                                      IsChecked="{Binding ApplyToDesktop}"/>
                                        <TextBlock Text="{loc:T DesktopUse}" FontSize="12"
                                                   Foreground="{DynamicResource TextDim}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- sliders -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,16,18">
                        <StackPanel>
                            <Border Background="{DynamicResource Card}" CornerRadius="12" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{loc:T SectionGeneral}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{loc:T GeneralHint}" Style="{StaticResource Caption}"
                                               Margin="0,3,0,12" TextWrapping="Wrap"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="{loc:T StartupTitle}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:T StartupHint}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                                      IsChecked="{Binding StartWithWindows}"
                                                      ToolTip="{loc:T StartupHint}"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource Border}"
                                            Opacity="0.6"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="{loc:T StartupMinimizeTitle}" FontSize="12.5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:T StartupMinimizeHint}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                                      IsChecked="{Binding StartMinimized}"
                                                      ToolTip="{loc:T StartupMinimizeHint}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- activation mode -->
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,20">
                                <TextBlock Text="{loc:T ModeHeader}" Style="{StaticResource SectionLabel}"/>
                                <Border Background="{DynamicResource Bg}" CornerRadius="8" Padding="3">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource Segment}" Content="{loc:T ModeForeground}"
                                                     GroupName="Mode"
                                                     IsChecked="{Binding SelectedGame.IsForegroundMode}"
                                                     ToolTip="{loc:T ModeForegroundTip}"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="{loc:T ModeRunning}"
                                                     GroupName="Mode"
                                                     IsChecked="{Binding SelectedGame.IsWhileRunningMode}"
                                                     ToolTip="{loc:T ModeRunningTip}"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- vibrance -->
                            <TextBlock Text="{loc:T SectionVibrance}" Style="{StaticResource SectionLabel}"/>

                            <local:SliderRow Label="{loc:T Vibrance}" Unit="%"
                                             Minimum="0" Neutral="50"
                                             Maximum="{Binding EditedProfile.VibranceMax}"
                                             Value="{Binding EditedProfile.Vibrance, Mode=TwoWay}"
                                             Hint="{loc:T VibranceHint}"/>

                            <Border Background="{DynamicResource Bg}" CornerRadius="10" Padding="12,10"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{loc:T OverrideTitle}" FontSize="12.5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:T OverrideHint}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding EditedProfile.OverrideEnabled}"/>
                                    </Grid>
                                    <Border Background="{DynamicResource WarningFill}" CornerRadius="6" Padding="9,7" Margin="0,10,0,0"
                                            Visibility="{Binding EditedProfile.OverrideEnabled,
                                                         Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:T OverrideWarning}" FontSize="10.5"
                                                   Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- image -->
                            <TextBlock Text="{loc:T SectionImage}" Style="{StaticResource SectionLabel}"/>

                            <local:SliderRow Label="{loc:T Contrast}" Neutral="50"
                                             Value="{Binding EditedProfile.Contrast, Mode=TwoWay}"/>
                            <local:SliderRow Label="{loc:T Brightness}" Neutral="50"
                                             Value="{Binding EditedProfile.Brightness, Mode=TwoWay}"/>
                            <local:SliderRow Label="{loc:T Temperature}" Neutral="50"
                                             Value="{Binding EditedProfile.Temperature, Mode=TwoWay}"
                                             Hint="{loc:T TemperatureHint}"/>
                            <local:SliderRow Label="{loc:T Tint}" Neutral="50"
                                             Value="{Binding EditedProfile.Tint, Mode=TwoWay}"
                                             Hint="{loc:T TintHint}"/>

                            <!-- live preview -->
                            <Border Background="{DynamicResource Bg}" CornerRadius="10" Padding="12,10"
                                    Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:T PreviewTitle}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:T PreviewHint}" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" IsChecked="{Binding LivePreview}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- panel footer -->
            <Border Grid.Row="2" Padding="20,14" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0.6,0,0">
                        <Grid>
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T BtnReset}"
                                    HorizontalAlignment="Left" Command="{Binding ResetSelectedCommand}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource GhostButton}" Content="{loc:T BtnClose}"
                                        Command="{Binding CloseDetailCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource DangerButton}" Content="{loc:T BtnDelete}"
                                        Command="{Binding RemoveGameCommand}"
                                        CommandParameter="{Binding SelectedGame}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </Border>

        <!-- ==================== status bar ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="0,0,13,13" ClipToBounds="True"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0.6,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextFaint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StatusKind.Active}">
                                        <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StatusKind.Preview}">
                                        <Setter Property="Fill" Value="{DynamicResource Accent2}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StatusKind.Desktop}">
                                        <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:StatusKind.Unavailable}">
                                        <Setter Property="Fill" Value="{DynamicResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveDetail}" Style="{StaticResource Caption}"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                </StackPanel>

                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="{loc:T OpenSettingsFolder}" Command="{Binding OpenConfigFolderCommand}"/>
            </Grid>
        </Border>
        </Grid>
        </Border>
    </Border>
</Window>
